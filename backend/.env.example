# Copy to `.env` and fill in. Never commit the real file.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any Gemini Flash model id.
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated browser origins allowed to call this API. No wildcards.
ALLOWED_ORIGINS=http://localhost:3000

# When true, /api/v1/brief returns a bundled, clearly labelled sample brief and
# never calls GDELT or Gemini. Only ever set this deliberately - the API does
# not fall back to demo data when a real request fails.
DEMO_MODE=false
