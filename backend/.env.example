# Copy to `.env` and fill in. Never commit the real file — `.env.example` is
# tracked, so a key pasted here goes straight to the repository.

# Tavily news search: https://www.tavily.com (free "Researcher" tier, no card)
TAVILY_API_KEY=

# `basic` costs 1 credit per search, `advanced` costs 2. The free tier is
# 1,000 credits/month, so `basic` keeps the full search budget.
TAVILY_SEARCH_DEPTH=basic

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any Gemini Flash model id. Pinned rather than `gemini-flash-latest` so a
# Google-side rollout cannot change behaviour under a running deployment.
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated browser origins allowed to call this API. No wildcards.
ALLOWED_ORIGINS=http://localhost:3000

# Optional. Regex for origins that cannot be listed literally — Vercel preview
# URLs change every deploy, and their branch aliases get truncated and hashed
# once the hostname would exceed the 63-character DNS limit. Leave empty unless
# you need it, and always anchor it and scope it to hosts you control:
#   ALLOWED_ORIGIN_REGEX=^https://[a-z0-9-]+-yourteam-projects\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# When true, /api/v1/brief returns a bundled, clearly labelled sample brief and
# never calls Tavily or Gemini. Only ever set this deliberately - the API does
# not fall back to demo data when a real request fails.
DEMO_MODE=false
